{
  "name": "leanish-supply-chain",
  "private": true,
  "version": "0.8.0",
  "description": "Dependency security and freshness for npm and Gradle repos: a CI gate that blocks only what a PR makes worse, plus the secure-it and bump-it remediation tools.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "core/*",
    "bump-it",
    "secure-it"
  ],
  "scripts": {
    "check": "node --test test/workspace-layout.test.mjs && npm run check --workspaces",
    "clean": "npm exec --workspaces --include-workspace-root -c 'rm -rf coverage node_modules/.vite node_modules/.vite-temp'",
    "clean:deps": "npm exec --workspaces --include-workspace-root -c 'rm -rf coverage node_modules'"
  },
  "devDependencies": {
    "rolldown": "^1.2.14"
  }
}
