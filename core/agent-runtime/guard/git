#!/bin/bash
# Copied from leanish/leanish-development agents/bump-it/local/guard/git at c6282df; see PROVENANCE.md.
# Local changes: messages say "agent guard" (secure-it and bump-it share these); "the handler" is "the tool"; only
# pushes are checked, and a push to repositories on this machine passes; lib.sh and the real git are found without
# starting processes.
# agent guard for git: catches a mistaken push early, with a message saying the tool publishes. It is a guard rail,
# not a boundary: the agent's token is read-only and its git metadata can't be written (see docs/security-model.md),
# so remotes, config and `-c` settings aren't parsed here. A push to a remote whose every URL is on this machine
# passes: tests push to bare repositories in temp dirs, and that publishes nothing.
# No `set -u`: macOS's bash 3.2 treats an empty "${array[@]}" as unbound.
# Without `dirname`: every process started here adds to each guarded call.
case "$0" in */*) source "${0%/*}/lib.sh" ;; *) source ./lib.sh ;; esac
real_bin git

# Global options come before the subcommand.
args=("$@")
i=0
while [ "$i" -lt "${#args[@]}" ]; do
  case "${args[$i]}" in
    # Every global option git takes with a separate value: one missing here would be taken for the subcommand.
    -C|-c|--git-dir|--work-tree|--namespace|--exec-path|--attr-source|--config-env) i=$((i + 2)) ;;
    -*) i=$((i + 1)) ;;
    *) break ;;
  esac
done
sub=${args[$i]:-}
global=("${args[@]:0:$i}")
rest=("${args[@]:$((i + 1))}")

deny_push() {
  deny "git push (the tool pushes what you leave in the working tree)"
}

# A push to a named remote whose every push URL is on this machine; anything else is the tool's job. Only the
# options the tests and workspaces use are understood, wherever they are: git reads options after the remote and
# refspecs too, and one taking a value could hide the destination or run a command (`--receive-pack`).
check_push() {
  local arg remote="" urls url options=true
  for arg in "${rest[@]}"; do
    if [ "$options" = true ]; then
      case "$arg" in
        -q|--quiet|-v|--verbose|--no-verify|--porcelain|-f|--force|--force-with-lease|--force-with-lease=*|--atomic|-u|--set-upstream|-n|--dry-run|-d|--delete) continue ;;
        --) options=false; continue ;;
        -*) deny_push ;;
      esac
    fi
    # The first operand is the remote; the rest are refspecs.
    [ -n "$remote" ] || remote=$arg
  done
  # Named remotes only: a URL or path given directly can still be rewritten to a network one
  # (`url.<base>.insteadOf`), while `remote get-url` expands the rewrites (`-c` ones too: the global options are
  # passed along) and lists every push URL of a remote.
  [ -n "$remote" ] || deny_push
  urls=$("$real" "${global[@]}" remote get-url --push --all -- "$remote" 2>/dev/null) || deny_push
  [ -n "$urls" ] || deny_push
  while IFS= read -r url; do
    case "$url" in
      /*|file:///*) ;;
      *) deny_push ;;
    esac
  done <<EOF
$urls
EOF
  # Backstop for what the URLs don't show, such as submodules pushed along: git and the git commands it starts
  # may use only the local transport.
  export GIT_ALLOW_PROTOCOL=file
}

case "$sub" in
  push) check_push ;;
  # The plumbing under push takes a destination URL directly.
  send-pack|http-push) deny_push ;;
esac
exec "$real" "$@"
