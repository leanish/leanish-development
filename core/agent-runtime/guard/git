#!/bin/bash
# Copied from leanish/leanish-development agents/bump-it/local/guard/git at c6282df; see PROVENANCE.md.
# Local changes: messages say "agent guard" (secure-it and bump-it share these); "the handler" is "the tool";
# `-c core.hooksPath=/dev/null`, `-c credential.helper=`, `git remote add` and pushes to repositories on this machine
# pass; lib.sh,
# the real git and config names are handled without starting processes.
# agent guard for git: no pushes (the tool publishes; the agent's git
# metadata is read-only anyway), and existing remotes and credential settings
# can't be changed. Everything else passes through to the real git. Three exceptions let a
# repository's own tests run: `-c core.hooksPath=/dev/null` (it only turns hooks
# off), `-c credential.helper=` (it only turns credential helpers off), and a push
# to a remote whose every URL is on this machine (tests push to bare repositories
# in temp dirs; that publishes nothing).
# No `set -u`: macOS's bash 3.2 treats an empty "${array[@]}" as unbound.
# Without `dirname`: every process started here adds to each guarded call.
case "$0" in */*) source "${0%/*}/lib.sh" ;; *) source ./lib.sh ;; esac
real_bin git

# Config names are case-insensitive. They're compared with nocasematch, switched on only around a name and never for
# a value: lowercasing with `tr` cost two processes per `-c`, which slowed a repository's tests that call git a lot.
names_match() {
  local status=1
  shopt -s nocasematch
  # `[[ == ]]` with a quoted right side: a literal comparison that honors nocasematch (`[ = ]` doesn't).
  [[ "$1" == "$2" ]] && status=0
  shopt -u nocasematch
  return "$status"
}

# Config keys that would redirect pushes or credentials.
risky_key() {
  local status=1
  shopt -s nocasematch
  case "$1" in
    remote.*|url.*|credential*|include.*|includeif.*|core.sshcommand|core.askpass|core.hookspath|core.gitproxy|http.*extraheader*|http.*proxy*|pushurl) status=0 ;;
  esac
  shopt -u nocasematch
  return "$status"
}

# Exactly `core.hooksPath=/dev/null`: the per-command way to run no hooks at all.
hooks_off() {
  names_match "${1%%=*}" "core.hookspath" && [ "$1" != "${1%%=*}" ] && [ "${1#*=}" = "/dev/null" ]
}

# Exactly `credential.helper=` with an empty value: it clears the helper list, so git asks no helper for credentials
# (a release installer under test runs git this way).
credentials_off() {
  names_match "${1%%=*}" "credential.helper" && [ "$1" = "${1%%=*}=" ]
}

# Global options come before the subcommand.
args=("$@")
i=0
while [ "$i" -lt "${#args[@]}" ]; do
  a=${args[$i]}
  case "$a" in
    -C|--git-dir|--work-tree|--namespace|--exec-path) i=$((i + 2)) ;;
    -c)
      setting=${args[$((i + 1))]:-}
      hooks_off "$setting" || credentials_off "$setting" || { risky_key "${setting%%=*}" && deny "git -c ${setting%%=*}"; }
      i=$((i + 2)) ;;
    --config-env=*) deny "git --config-env" ;;
    -*) i=$((i + 1)) ;;
    *) break ;;
  esac
done
sub=${args[$i]:-}
global=("${args[@]:0:$i}")
rest=("${args[@]:$((i + 1))}")

# Reading remotes, and adding one, pass: a push is checked against every push URL of its remote when it runs, so a
# remote added here reaches no network either (a release installer under test adds its origin to a new repository).
# Changing an existing remote doesn't pass.
check_remote() {
  case "${rest[0]:-}" in
    ""|-v|--verbose|show|get-url|add) ;;
    *) deny "git remote ${rest[0]}" ;;
  esac
}

check_config() {
  local arg read=false write=false scope="" key="" values=0
  for arg in "${rest[@]}"; do
    case "$arg" in
      --get|--get-all|--get-regexp|--get-urlmatch|-l|--list|get|list) read=true ;;
      -e|--edit) deny "git config --edit" ;;
      --unset|--unset-all|--add|--replace-all|--rename-section|--remove-section|set|unset) write=true ;;
      --global|--system) scope=$arg ;;
      -*) ;;
      *) if [ -z "$key" ]; then key=$arg; else values=$((values + 1)); fi ;;
    esac
  done
  # `git config <key>` alone is a read too.
  if [ "$write" = false ] && { [ "$read" = true ] || [ "$values" -eq 0 ]; }; then return 0; fi
  [ -z "$scope" ] || deny "git config $scope (write)"
  [ -n "$key" ] && risky_key "$key" && deny "git config $key"
  return 0
}

deny_push() {
  deny "git push (the tool pushes what you leave in the working tree)"
}

# A push to a named remote whose every push URL is on this machine; anything else is the tool's job. Only the
# options the tests and workspaces use are understood, wherever they are: git reads options after the remote and
# refspecs too, and one taking a value could hide the destination or run a command (`--receive-pack`).
check_push() {
  local arg remote="" urls url options=true
  for arg in "${rest[@]}"; do
    if [ "$options" = true ]; then
      case "$arg" in
        -q|--quiet|-v|--verbose|--no-verify|--porcelain|-f|--force|--force-with-lease|--force-with-lease=*|--atomic|-u|--set-upstream|-n|--dry-run|-d|--delete) continue ;;
        --) options=false; continue ;;
        -*) deny_push ;;
      esac
    fi
    # The first operand is the remote; the rest are refspecs.
    [ -n "$remote" ] || remote=$arg
  done
  # Named remotes only: a URL or path given directly can still be rewritten to a network one
  # (`url.<base>.insteadOf`), while `remote get-url` expands the rewrites and lists every push URL of a remote.
  [ -n "$remote" ] || deny_push
  urls=$("$real" "${global[@]}" remote get-url --push --all -- "$remote" 2>/dev/null) || deny_push
  [ -n "$urls" ] || deny_push
  while IFS= read -r url; do
    case "$url" in
      /*|file:///*) ;;
      *) deny_push ;;
    esac
  done <<EOF
$urls
EOF
  # Backstop for what the URLs don't show, such as submodules pushed along: git and the git commands it starts
  # may use only the local transport.
  export GIT_ALLOW_PROTOCOL=file
}

case "$sub" in
  push) check_push ;;
  remote) check_remote ;;
  config) check_config ;;
esac
exec "$real" "$@"
