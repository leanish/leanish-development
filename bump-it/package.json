{
  "name": "@leanish/bump-it",
  "version": "0.0.0",
  "private": true,
  "description": "Keeps dependencies fresh with the versions the supply-chain gate's rule picks: one routine PR for minors, patches and the npm transitive refresh, one PR per major, each verified by the gate before it's published.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "bump-it": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/semver": "^7.8.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@leanish/agent-runtime": "0.0.0",
    "@leanish/gate": "0.0.0",
    "@leanish/tool-runtime": "0.0.0",
    "semver": "^7.8.5",
    "yaml": "^2.9.1"
  },
  "exports": {}
}
